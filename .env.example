# =============================================================================
# NewsXpressLive — Environment Variables Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit the .env file (it is in .gitignore)
#
# On cPanel/Shared hosting → set these in "PHP Environment Variables" or
# add to .htaccess (see DEPLOYMENT.md for details).
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=newsxpresslive
DB_USER=your_db_username
DB_PASS=your_db_password


# -----------------------------------------------------------------------------
# FIREBASE
# -----------------------------------------------------------------------------

# Your Firebase project ID (visible in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Realtime Database URL
# Format: https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DB_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com


# -----------------------------------------------------------------------------
# CDN  (optional — leave blank to serve images from your own server)
# -----------------------------------------------------------------------------
# CDN_BASE_URL=https://cdn.yourdomain.com


# -----------------------------------------------------------------------------
# REDIS  (optional — for caching; leave blank if not installed)
# -----------------------------------------------------------------------------
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TIMEOUT=2.0


# -----------------------------------------------------------------------------
# AI SERVICES  (optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...


# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------
# SESSION_TTL=7200


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# firebase_service_key.json must be placed at:
#   helpers/firebase_service_key.json
# Copy helpers/firebase_service_key.demo.json and fill in real values.
# See DEPLOYMENT.md → Step 5 for full instructions.
