# =============================================================================
# NewsXpressLive — Environment Variables Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit the .env file (it is in .gitignore)
#
# On cPanel/Shared hosting → set these in "PHP Environment Variables" or
# add to .htaccess (see DEPLOYMENT.md for details).
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PASS=your_db_password


# -----------------------------------------------------------------------------
# SITE URL  (no trailing slash)
# Set to your actual public domain, e.g. https://example.com
# -----------------------------------------------------------------------------
SITE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# ADMIN PANEL BASE PATH  (no trailing slash)
# The URL path prefix where admin_panel/ is served.
# Example: /admin_panel  or  /backoffice
# -----------------------------------------------------------------------------
ADMIN_BASE_PATH=/admin_panel


# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------
MAIL_FROM=noreply@yourdomain.com

# App base URL used by cron jobs for links embedded in emails
APP_BASE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# FIREBASE
# -----------------------------------------------------------------------------

# Your Firebase project ID (visible in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Realtime Database URL
# Format: https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DB_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com


# -----------------------------------------------------------------------------
# CDN  (optional — leave blank to serve images from your own server)
# -----------------------------------------------------------------------------
# CDN_BASE_URL=https://cdn.yourdomain.com


# -----------------------------------------------------------------------------
# REDIS  (optional — for caching; leave blank if not installed)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASS=your_redis_password
# REDIS_DB=0
# REDIS_TIMEOUT=2.0


# -----------------------------------------------------------------------------
# AI SERVICES  (optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...


# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------
# SESSION_TTL=7200


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# firebase_service_key.json must be placed at:
#   helpers/firebase_service_key.json
# Copy helpers/firebase_service_key.demo.json and fill in real values.
# See DEPLOYMENT.md → Step 5 for full instructions.


# -----------------------------------------------------------------------------
# RAZORPAY  (required for Blue Tick payments + refunds)
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret


# -----------------------------------------------------------------------------
# SENDGRID  (required for transactional emails)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=SG.xxx
# MAIL_FROM=noreply@newsxpresslive.com
# MAIL_FROM_NAME=NewsXpressLive


# -----------------------------------------------------------------------------
# ADMIN API TOKEN  (used by admin/*.php endpoints)
# -----------------------------------------------------------------------------
# ADMIN_API_TOKEN=generate_a_long_random_string_here


# -----------------------------------------------------------------------------
# KYC  (account number encryption)
# -----------------------------------------------------------------------------
# KYC_ENCRYPTION_KEY=change_this_to_a_32_byte_random_key_here


# -----------------------------------------------------------------------------
# WhatsApp Business API  (Meta Cloud API)
# -----------------------------------------------------------------------------
# WHATSAPP_VERIFY_TOKEN=newsxpresslive_verify
# WHATSAPP_APP_SECRET=your_meta_app_secret
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_permanent_access_token


# -----------------------------------------------------------------------------
# Smart Referral Reward System (v29)
# -----------------------------------------------------------------------------
# IPAPI_KEY=your_ipapi_key_here
# REWARD_SYSTEM_ACTIVE=true
# REWARD_ALERT_EMAIL=admin@newsxpresslive.com


# -----------------------------------------------------------------------------
# Live Streaming — Agora.io (v32)
# -----------------------------------------------------------------------------
# AGORA_APP_ID=your_agora_app_id
# AGORA_APP_CERT=your_agora_app_certificate
# AGORA_CUSTOMER_ID=your_agora_customer_id
# AGORA_CUSTOMER_SECRET=your_agora_customer_secret


# -----------------------------------------------------------------------------
# AI Translation (auto-translate feature)
# -----------------------------------------------------------------------------
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_key
# AUTO_TRANSLATE_ENABLED=true
# AUTO_TRANSLATE_LANGS=hi,en,mr,gu,pa


# -----------------------------------------------------------------------------
# AI Features — Gemini (horoscope, quiz, bot reporter)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=AIza...
# ASSISTANT_ENABLED=true
# ASSISTANT_RATE_LIMIT=20


# -----------------------------------------------------------------------------
# Cricket Live Score Widget (v34)
# -----------------------------------------------------------------------------
# CRICAPI_KEY=your_cricapi_key
# CRICKET_WIDGET_ENABLED=true


# -----------------------------------------------------------------------------
# Horoscope / Rashifal (v34)
# -----------------------------------------------------------------------------
# ASTRO_API_KEY=your_astro_api_key
# HOROSCOPE_SOURCE=gemini   # gemini | skip


# -----------------------------------------------------------------------------
# AI Reporter Bot (v34)
# -----------------------------------------------------------------------------
# BOT_REPORTER_ENABLED=true
# BOT_REVIEW_REQUIRED=true
