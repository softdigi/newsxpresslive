# Environment and secrets
.env
.env.*
!.env.example
*.env
firebase_service_key.json

# Flutter Firebase config files (real — generated by FlutterFire CLI)
# Demo/template versions (.demo.*) are safe to commit
flutter_app/lib/firebase_options.dart
flutter_app/android/app/google-services.json
flutter_app/ios/Runner/GoogleService-Info.plist
flutter_app/lib/core/constants/app_config.dart

# Logs
logs/*
!logs/.gitkeep
error_log
*.log

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dependencies (if any)
vendor/
node_modules/

# Uploads (user content)
uploads/*
!uploads/.gitkeep

# Temporary files
*.tmp
*.cache

# Private files (KYC docs, exports) — stored outside public_html on server
private/
backups/

# Flutter build output and tooling
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/pubspec.lock
